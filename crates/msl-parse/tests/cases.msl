=== entry-points
expect: accept
struct main0_in { float4 a [[user(locn0)]]; };
struct main0_out { float4 c [[color(0)]]; };
[[early_fragment_tests]] fragment main0_out main0(main0_in in [[stage_in]], float4 gl_FragCoord [[position]])
{
    main0_out out = {};
    out.c = in.a;
    return out;
}
vertex float4 main0_v(uint vid [[vertex_id]], uint iid [[instance_id]]) { return float4(float(vid), float(iid), 0.0, 1.0); }
kernel void k(uint3 gid [[thread_position_in_grid]]) { }

