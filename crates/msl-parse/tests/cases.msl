=== dm_bs-helper
expect: accept
prelude: dm_bs
struct dm_border_t { float4 k[4]; };
template<typename T, typename Tex, typename... A> T dm_bs(T r, constant dm_border_t* b, uint i, Tex t, sampler w, A... a) { return r; }
float4 f(constant dm_border_t* b, texture2d<float> t, sampler s, float2 uv)
{
    float4 x = dm_bs(float4(0.0), b, 0u, t, s, uv);
    float y = dm_bs(0.0, b, 1u, t, s, uv, level(0.0));
    return x + y;
}

