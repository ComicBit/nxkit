=== texture-methods
expect: accept
float4 f(texture2d<float> t, texture2d_array<float> ta, texturecube<float> tc, depth2d<float> d, depth2d_array<float> da,
         texture3d<float> t3, sampler s, float2 uv, float3 dir, uint2 px, texture2d<float, access::write> w)
{
    float4 a = t.sample(s, uv) + t.sample(s, uv, level(0.0)) + t.sample(s, uv, bias(1.0), int2(1, 1));
    float4 b = ta.sample(s, uv, 1u) + tc.sample(s, dir) + t3.sample(s, dir, gradient3d(dir, dir));
    float c = d.sample_compare(s, uv, 0.5) + da.sample_compare(s, uv, 2, 0.5, level(0));
    float4 g = t.gather(s, uv, int2(0), component::y) + d.gather(s, uv);
    float4 r = t.read(px) + t.read(px, 0u);
    w.write(a, px);
    uint wd = t.get_width() + t.get_height(0u) + ta.get_array_size() + t.get_num_mip_levels();
    float lod = t.calculate_clamped_lod(s, uv) + t.calculate_unclamped_lod(s, uv) + ta.calculate_clamped_lod(s, uv);
    return a + b + g + r + c;
}

