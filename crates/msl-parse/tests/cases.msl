=== assignments
expect: accept
void f(device float* p, thread float4& v_unused_name_avoided)
{
    float4 v = float4(0.0);
    int i = 0;
    uint u = 1u;
    v.x = 1.0;
    v.xy = float2(1.0, 2.0);
    v += float4(1.0);
    i <<= 2;
    i |= 1;
    u ^= 3u;
    *p = 2.0;
    p[1] = 3.0;
    v[i] = 4.0;
}

