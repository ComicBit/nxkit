float f(int c, float x)
{
    float r = 0.0;
    { r = x; }
    ;
    if (c > 0) r = 1.0; else { r = 2.0; }
    if (c == 3) return r;
    switch (c)
    {
        case 0:
        case 1u:
        {
            r = 3.0;
            break;
        }
        default:
            break;
    }
    do { r = r + 1.0; } while (r < 10.0);
    while (r > 0.0) { r = r - 1.0; if (r < 5.0) break; else continue; }
    for (int i = 0; i < 4; i += 1) { r = r * 2.0; }
    int j;
    for (j = 0; j < 2; j += 1) { }
    for (;;) { break; }
    return r;
}

