    uint t = (a << 2) | (b >> 1u) & (a ^ b);
    float z = x * y + x / y - x;
    bool r = p || q && !p;
    bool4 cmp = float4(x) < float4(y);
    bool e = x == y || x != y || x <= y || x >= y || x > y;
    short sh = short(1);
    int promoted = sh + sh;
    return r;
}

