=== simd-builtins
expect: accept
struct I { float4 u [[user(locn0)]]; bool ff [[front_facing]]; };
kernel void k(device uint* p [[buffer(0)]], uint l [[thread_index_in_simdgroup]])
{
    uint h = mulhi(p[0], p[1]);
    int2 hi = mulhi(int2(1, 2), int2(3, 4));
    float f = simd_shuffle(as_type<float>(h), ushort(l));
    int2 si = simd_shuffle(hi, ushort(l ^ 1u));
    bool b = simd_any(f > 0.0) && simd_all(si.x > 0);
    p[2] = b ? h : 0u;
}

