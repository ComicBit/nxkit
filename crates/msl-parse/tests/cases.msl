=== builtins
expect: accept
float4 f(float x, float4 v, int i, uint u, int2 i2)
{
    float a = abs(x) + sqrt(x) + rsqrt(x) + exp2(x) + log2(x) + floor(x) + fract(x) + saturate(x) + sign(x);
    int ai = abs(i);
    float b = min(x, 1.0) + precise::max(x, 2.0) + fast::min(x, x) + pow(x, x) + step(x, x) + fmod(x, x);
    float4 c = fma(v, v, v) + clamp(v, 0.0, 1.0) + mix(v, v, x) + smoothstep(v, v, v) + precise::clamp(v, v, v);
    uint p = popcount(u) + clz(u);
    int2 ci = clz(i2);
    bool n = isnan(x);
    bool4 nn = isinf(v);
    float4 s = select(v, v, isnan(v));
    bool al = all(nn) || any(nn);
    float d = dot(v, v) + length(v) + distance(v, v);
    float3 cr = cross(v.xyz, v.xyz);
    float4 un = unpack_unorm4x8_to_float(u);
    float2 h2 = unpack_half2x16(u);
    uint eb = extract_bits(u, 0u, 4u);
    uint ib = insert_bits(u, u, 0u, 4u);
    float4 bc = max(v, x);
    return c + s + un;
}

