# Checker cases shared by the Rust tests (tests/cases.rs) and the Python cross-check (tools/check_cases.py).
#
# A case starts with `=== name`. Then header lines:
#   expect: accept | reject <key> | <key> ... | recursion | crash:<PythonException> | lex-error
#           (reason keys separated by ` | `, a repeated key is listed once per occurrence)
#   prelude: <helper>   optional: the template items of this case count as the engine helper <helper>
# Everything after the header lines up to the next `===` is the source.
# Lines starting with `#` before the first case are comments.

=== empty-file
expect: accept

=== preprocessor-accepted
expect: accept
#include <metal_stdlib>
#include <simd/simd.h>
#pragma clang diagnostic ignored "-Wmissing-prototypes"
using namespace metal;

=== preprocessor-rejected
expect: reject pp:#include <metal_atomic> | pp:#define X
#include <metal_atomic>
#define X 1

=== struct-fields-and-attrs
expect: accept
struct main0_out
{
    float4 color0 [[color(0)]];
    float4 gl_Position [[position, invariant]];
    float gl_PointSize [[point_size]];
    float a, b;
    uint arr[4];
    packed_float3 p;
    float4x4 m;
    float depth_out [[depth(any)]];
};

=== struct-forward
expect: reject struct-forward
struct S;

=== struct-field-attr
expect: reject field-attr:sample_id
